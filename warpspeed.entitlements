<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <!--
        A Boolean value that indicates whether the app creates and manages virtual machines.
        The entitlement is required to use the Hypervisor APIs in any process.
        -->
        <key>com.apple.security.hypervisor</key>
        <true/>
        <!--
        Let appbox::respawn pin the host's malloc layout: the parent needs task_for_pid on the
        child (a copy of the same binary), which requires both of these.
        -->
        <key>com.apple.security.cs.debugger</key>
        <true/>
        <key>com.apple.security.get-task-allow</key>
        <true/>
    </dict>
</plist>
